        contact{ name = "P_9_3"}

    }

    #NS wire
    region{
        obelisk{
            base_x = [$square_length / 2, $square_length / 2]
            base_y = [$begin_square_NS_y, $begin_square_NS_y + $square_length]
            base_z = [$begin_screening_depth, $begin_screening_depth + $screening_gate_depth]
            top_x = [$max_x, $max_x]
            top_y = [$begin_square_NS_y + $max_x - $square_length / 2, $begin_square_NS_y + $max_x + $square_length / 2]
            top_z = [$begin_screening_depth, $begin_screening_depth + $screening_gate_depth]
    }
