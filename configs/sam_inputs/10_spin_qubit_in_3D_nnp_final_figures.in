}

        #DEFINING SPACING AND RESOLUTION
 
 
grid{                      # this group is required in every input file
    xgrid{                 # grid in x direction
        line{ 
            pos = $min_x    # start of device at x = 0.0nm
            spacing = 8  # grid spacing 1.0nm
        }  
        line{                                  
            pos = $max_x   # end of device
            spacing = 8  # grid spacing 1.0nm
        }   
    }
    ygrid{                 # grid in x direction
        line{ 
            pos = $min_y      # start of device at y = 0.0nm
            spacing = 8  # grid spacing 1.0nm
        }  
        line{                                  
            pos = $max_y     # end of device at y = 50.0nm
            spacing = 8  # grid spacing 1.0nm
        }   
    }
    zgrid{                 # grid in x direction
        line{ 
            pos = 0.0      # start of device at z = 0.0nm
            spacing = 5  # grid spacing 1.0nm
        }  
        line{                                  
            pos = $begin_plunger_layer + $plunger_layer_depth    # end of device at z = 50.0nm
            spacing = 5  # grid spacing 1.0nm
        }   
        line{ pos = 1
            spacing = 2}
        line{ pos = $DHG_depth + 20
            spacing = 4}     
        }
}

classical{ 
    Gamma{ }
    HH{ }
    LH{ }
    SO{ }
   Delta{ }
#    output_bandedges{ averaged = no  profiles="Delta electron_fermi_level" }
#    
    output_carrier_densities{ }
#    output_ionized_dopant_densities{ }
#    output_intrinsic_density{ }
}

poisson{ 
#    between_fermi_levels{ }
    output_potential{ }
    output_electric_field{ }
#    newton_solver{ iterations = 200 }
}

$N_states = 5

# Quantum region #
$xq_min = $min_x
$xq_max = $max_x

$zq_min = $DHG_depth - 10 
$zq_max = $DHG_depth + 10

$yq_max = $end_sensor_n_y
$yq_min = $start_sensor_s_y

quantum{ 
    region{ 
        name = "QuantumRegion"
        x = [ $xq_min, $xq_max ]
        y = [ $yq_min, $yq_max ]
        z = [ $zq_min, $zq_max ]
                no_density = no
        boundary{ x = dirichlet y = dirichlet z = dirichlet }
        output_quantum_densities{ }
        output_wavefunctions{ 
            max_num = $N_states 
            amplitudes = no
            probabilities = yes
            in_one_file = yes
            energy_shift = both
            scale = 100
        }
        Delta{ 
            num_ev = $N_states
            arpack{ }
        }
        HH{
            num_ev = $N_states
            arpack { } 
        }
    }
}
