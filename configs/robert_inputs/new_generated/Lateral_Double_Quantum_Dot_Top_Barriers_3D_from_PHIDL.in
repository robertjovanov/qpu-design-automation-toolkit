#--------------------------------------
#--- generated gate voltage values ---
#--------------------------------------
$V_OC_L           = 0 # (V) generated
$V_B1             = 0 # (V) generated
$V_P1             = -3 # (V) generated
$V_B2             = 0 # (V) generated
$V_P2             = -3 # (V) generated
$V_B3             = 0 # (V) generated
$V_OC_R           = 0 # (V) generated

# Double Quantum Dot - 3D - Robert Jovanov

#----------------------
#--- solver control ---
#----------------------

#--- choice of solvers ---

$strain  = 1
$poisson = 1
$quantum = 0
$quantum_poisson =  0

$decomposition = 0            # use decomposition algorithm to solve 3D quantum poisson if set to 1 (quantization on the z direction)

#--- numerical parameters for the quantum solver ----

$n_c_Ge_QW_HH = 100
$n_c_Ge_QW_LH = 10

#-------------------------
#--- system definition ---
#-------------------------

#--- temperature and boundary conditions ---

$temperature = 10e-3 # (K)

$V_PG1    = -3 # (V)
$V_BG1    = 0  # (V)
$V_BG2    = 0  # (V)
$V_PG2    = -3 # (V)
$V_BG3    = 0  # (V)
$V_source = 0  # (V)
$V_drain  = 0  # (V)
$V_remove_surface_charge = -1.5 # (V)

#--- doping and surface charges ---

$doping_cap             = 0.0# 5e18        # (cm^-3) doping in the modulation region of the cap layer
$doping_buffer          = 0.0# 5e18        # (cm^-3) doping in the modulation region of the buffer layer
$dop_energy             = 0.02             # (eV) activation energy of the impurity

$surface_charge_sheet   = 0#9.93016e+11 # (cm^-2) sheet charge density

#--- materials ---

$vacuum_level = 6.43 # (eV) 6.3 is a default
$work_function_OC   = 4.30 # (eV) work function of ohmic-contact metals Al
$work_function_Gate = 4.30 # (eV) work function of gate metals Al

$alloy_x = 0.15    # mol fraction of the Si in the SiGe alloy

#--- device ---

# Abbreviations:
# PG - plunger gate
# BG - barrier gate
# OC - ohmic contacts

# x-axis, transport / in-plane direction
# Sequential horizontal chain:
# Source | BG1 | PG1 | BG2 | PG2 | BG3 | Drain
# The x-origin is the LEFT boundary of the simulation domain.

# top-contact widths and gate widths
$Lx_Source          =   40    # (nm) width of the source ohmic contact at the top of the simulation domain
$Lx_BG1             =   40    # (nm) width of barrier gate 1
$Lx_PG_body         =   40    # (nm) width of the plunger-body neck in the lateral in-plane direction
$R_PG1              =   50    # (nm) radius of plunger gate 1 head
$Lx_BG2             =   40    # (nm) width of barrier gate 2
$R_PG2              =   50    # (nm) radius of plunger gate 2 head
$Lx_BG3             =   40    # (nm) width of barrier gate 3
$Lx_Drain           =   40    # (nm) width of the drain ohmic contact at the top of the simulation domain
$Lx_OC_bottom       =   30    # (nm) width of the ohmic contacts at the bottom (in the buffer)

# x-gaps along the transport direction
$Lx_Source_BG1      = 1000   # (nm) distance between the source ohmic edge and BG1
$Lx_BG1_PG1         =   20    # (nm) distance between BG1 and the PG1 head
$Lx_PG1_BG2         =   20    # (nm) distance between the PG1 head and BG2
$Lx_BG2_PG2         =   20    # (nm) distance between BG2 and the PG2 head
$Lx_PG2_BG3         =   20    # (nm) distance between the PG2 head and BG3
$Lx_BG3_Drain       = 1000   # (nm) distance between BG3 and the drain ohmic edge

# y-axis, the second in-plane direction
# Each plunger is a 3D "lollypop": rectangular body + circular head.
# We keep the global simulation-domain extents separate from the plunger-body dimensions.
$Ly_domain_top      =  100    # (nm) distance from y=0 to the top border of the simulation region
$Ly_domain_bottom   =  100    # (nm) distance from y=0 to the bottom border of the simulation region
$Ly_BG_top          =   40    # (nm) top y-extent of the barrier gates
$Ly_PG_body         =  100    # (nm) body length of each plunger gate, measured from y=0 upward

# z-axis, the growth direction
$Lz_PG              =   30 # (nm) thickness of the P Gate (PG)
$Lz_AlO_2           =    5 # (nm) minimum thickness of the layer between PG and BG
$Lz_BG              =   30 # (nm) thickness of the B Gate (BG)
$Lz_AlO_1           =    7 # (nm) minimum thickness of the layer between BG and the interface dielectric and cap
$Lz_Ge_cap          =    1 # (nm) thickness of the cs-Ge cap
$Lz_SiGe_cap        =  100 # (nm) thickness of the r-SiGe cap
$Lz_Ge_QW           =   15 # (nm) thickness of the cs-Ge quantum well
$Lz_SiGe_buffer     = 4000 # (nm) thickness of the r-SiGe buffer

$Lz_MD_buffer       =    1 # (nm) thickness of the modulation doping region in the buffer
$Lz_MD_cap          =    1 # (nm) thickness of the modulation doping region in the cap

$Lz_MD_buffer_dist  =   50 # (nm) distance of the modulation doping region in the buffer
$Lz_MD_cap_dist     =   50 # (nm) distance of the modulation doping region in the cap

$Lz_OC              =  250 # (nm) depth of the Ohmic contacts (from the surface)

#--- quantum region ---

$Lx_QR_margin       =   20 # (nm) margin from the outer barrier edges to the quantum-region edges in x
$Ly_QR_top          =   80 # (nm) distance of the top border of the quantum region to y=0
$Ly_QR_bottom       =   80 # (nm) distance of the bottom border of the quantum region to y=0
$Lz_QR_c_Ge_QW_barrier = 5 # (nm) distance of the border of the quantum region to the quantum well (at each side)

#--- 2DHG section ---

$Lz_2DHG                =    2 # (nm) distance of the 2DHG plane to the interface QW-cap 

#--- additional for grid ---

$Lx_GRID_margin         =  150 # (nm) margin around the active gate region where the finer x-grid ends
$Ly_GRID_medium         =   50 # (nm) distance to y=0 where the medium y-grid ends
$Lz_grid_buffer         = 1000 # (nm) distance between the modulation region in the buffer and the position where the coarse grid begins
$Lz_grid_cap            =   20 # (nm) distance in the cap to its Modulation region, where the grid resolution changes from fine to coarse

#--- grid spacings ---

$dx                      =   10 # (nm) grid resolution in the x direction
$dx_QD                   =    5 # (nm) grid resolution in the quantum dot region (x direction)
$dx_coarse               =  100 # (nm) coarse x-grid resolution in the long source-BG1 and BG3-drain gaps

$dy                      =    5 # (nm) grid resolution in the y direction
$dy_QD                   =    5 # (nm) grid resolution in the quantum dot region (y direction)

$dz_buffer_coarse        = 100  # (nm) grid resolution in the buffer region and substrate
$dz_buffer_medium        =  50  # (nm) grid resolution in the buffer region and substrate
$dz_buffer_fine          =   5  # (nm) grid resolution in the buffer region and substrate

$dz_MD_fine              = 0.5  # (nm) grid resolution around MD region
                         
$dz_QW_fine              = 0.5  # (nm) grid resolution in the growth direction - QW region
$dz_QW_coarse            =   1  # (nm) grid resolution in the growth direction - QW region

$dz_cap_fine             =  0.1 # (nm) grid resolution in the growth direction - cap region
$dz_oxide_gates_medium   =    2 # (nm) grid resolution in the growth direction - in the oxide and gate regions

#-------------------------------------------
#--- derived lines for design definition ---
#-------------------------------------------

#--- device ---
# Explicit left-to-right construction of the serial double-dot chain.

$x_domain_left  = 0.0

$x_Source_left   = $x_domain_left
$x_Source_right  = $x_Source_left + $Lx_Source
$x_Source_center = 0.5*($x_Source_left + $x_Source_right)
$x_Source_bottom = $x_Source_left + $Lx_OC_bottom

$x_BG1_left   = $x_Source_right + $Lx_Source_BG1
$x_BG1_right  = $x_BG1_left + $Lx_BG1
$x_BG1_center = 0.5*($x_BG1_left + $x_BG1_right)

$x_PG1_head_left    = $x_BG1_right + $Lx_BG1_PG1
$x_PG1_center       = $x_PG1_head_left + $R_PG1
$x_PG1_head_right   = $x_PG1_head_left + 2*$R_PG1
$x_PG1_body_left    = $x_PG1_center - 0.5*$Lx_PG_body
$x_PG1_body_right   = $x_PG1_center + 0.5*$Lx_PG_body

$x_BG2_left   = $x_PG1_head_right + $Lx_PG1_BG2
$x_BG2_right  = $x_BG2_left + $Lx_BG2
$x_BG2_center = 0.5*($x_BG2_left + $x_BG2_right)

$x_PG2_head_left    = $x_BG2_right + $Lx_BG2_PG2
$x_PG2_center       = $x_PG2_head_left + $R_PG2
$x_PG2_head_right   = $x_PG2_head_left + 2*$R_PG2
$x_PG2_body_left    = $x_PG2_center - 0.5*$Lx_PG_body
$x_PG2_body_right   = $x_PG2_center + 0.5*$Lx_PG_body

$x_BG3_left   = $x_PG2_head_right + $Lx_PG2_BG3
$x_BG3_right  = $x_BG3_left + $Lx_BG3
$x_BG3_center = 0.5*($x_BG3_left + $x_BG3_right)

$x_Drain_left   = $x_BG3_right + $Lx_BG3_Drain
$x_Drain_right  = $x_Drain_left + $Lx_Drain
$x_Drain_center = 0.5*($x_Drain_left + $x_Drain_right)
$x_Drain_bottom = $x_Drain_right - $Lx_OC_bottom

$x_domain_right = $x_Drain_right

$y_domain_bottom = -$Ly_domain_bottom
$y_domain_top    =  $Ly_domain_top
$y_BG_bottom     =  $y_domain_bottom
$y_BG_top        =  $Ly_BG_top
$y_PG_head_center = 0.0
$y_PG_body_bottom = 0.0
$y_PG_body_top    = $Ly_PG_body

$z_SiGe_buffer      = $Lz_SiGe_buffer
$z_GeQW             = $Lz_SiGe_buffer + $Lz_Ge_QW
$z_SiGe_cap         = $Lz_SiGe_buffer + $Lz_Ge_QW + $Lz_SiGe_cap
$z_Ge_cap           = $Lz_SiGe_buffer + $Lz_Ge_QW + $Lz_SiGe_cap + $Lz_Ge_cap
$z_BG_start         = $Lz_SiGe_buffer + $Lz_Ge_QW + $Lz_SiGe_cap + $Lz_Ge_cap + $Lz_AlO_1
$z_BG_end           = $Lz_SiGe_buffer + $Lz_Ge_QW + $Lz_SiGe_cap + $Lz_Ge_cap + $Lz_AlO_1 + $Lz_BG
$z_PG_start         = $Lz_SiGe_buffer + $Lz_Ge_QW + $Lz_SiGe_cap + $Lz_Ge_cap + $Lz_AlO_1 + $Lz_BG + $Lz_AlO_2
$z_PG_end           = $Lz_SiGe_buffer + $Lz_Ge_QW + $Lz_SiGe_cap + $Lz_Ge_cap + $Lz_AlO_1 + $Lz_BG + $Lz_AlO_2 + $Lz_PG

$z_MD_buffer_start  = $z_SiGe_buffer - $Lz_MD_buffer_dist - $Lz_MD_buffer
$z_MD_buffer_end    = $z_SiGe_buffer - $Lz_MD_buffer_dist   
$z_MD_cap_start     = $z_GeQW + $Lz_MD_cap_dist
$z_MD_cap_end       = $z_GeQW + $Lz_MD_cap_dist + $Lz_MD_cap

$z_OC               = $z_Ge_cap - $Lz_OC

$z_body_contact     = -$dz_buffer_coarse

#--- additional for grid ---

$x_GRID_left            = $x_BG1_left - $Lx_GRID_margin
$x_GRID_right           = $x_BG3_right + $Lx_GRID_margin

$y_GRID_medium_top      = $Ly_GRID_medium
$y_GRID_medium_bottom   = -$Ly_GRID_medium

$z_GRID_medium          = $z_MD_buffer_start - $Lz_grid_buffer           # Position where the coarse grid ends

#--- quantum region ---

$x_QR_left          = $x_BG1_left - $Lx_QR_margin
$x_QR_right         = $x_BG3_right + $Lx_QR_margin

$y_QR_top           =  $Ly_QR_top
$y_QR_bottom        = -$Ly_QR_bottom

$z_QR_c_Ge_QW_start = $z_SiGe_buffer - $Lz_QR_c_Ge_QW_barrier
$z_QR_c_Ge_QW_end   = $z_GeQW + $Lz_QR_c_Ge_QW_barrier

#--- doping and surface charges ---

$surface_charge_density = $surface_charge_sheet * 1e7/$Lz_Ge_cap # (cm^-3)

output{
    only_sections = no

    format2D = AvsAscii_one_file
    format3D = VTKAscii

    set_origin{ x = 0.0 y = 0.0 z = 0.0 }

    section2D{ name = "xy_QW" z = -7.5 }
    section2D{ name = "xz_QW" y = 100 }
    section2D{ name = "xy_full_top" z = 173 }
}

run{
    !WHEN $strain             strain{}
    !WHEN $poisson            poisson{}
    !WHEN $quantum            quantum{}
    !WHEN $quantum_poisson    quantum_poisson{}
}

# z is parallel to the growth direction
global{ 
    simulate3D{}
    temperature = $temperature
    crystal_zb{ 
        x_hkl = [1, 0, 0]
        y_hkl = [0, 1, 0]
    }
    substrate{
        name = "Si(x)Ge(1-x)"
        alloy_x = $alloy_x
    }
}

impurities{ 
    acceptor{
        name = modulation_doping
        energy = $dop_energy
        degeneracy = 4
    }
    charge{
        name = "surface_charge"
        type = "positive"
    }
}

contacts{
    vacuum_level = $vacuum_level
    schottky{ name = "OC_L" bias = 0 work_function = $work_function_OC - $V_OC_L }
    schottky{ name = "B1" bias = 0 work_function = $work_function_Gate - $V_B1 }
    schottky{ name = "P1" bias = 0 work_function = $work_function_Gate - $V_P1 }
    schottky{ name = "B2" bias = 0 work_function = $work_function_Gate - $V_B2 }
    schottky{ name = "P2" bias = 0 work_function = $work_function_Gate - $V_P2 }
    schottky{ name = "B3" bias = 0 work_function = $work_function_Gate - $V_B3 }
    schottky{ name = "OC_R" bias = 0 work_function = $work_function_OC - $V_OC_R }
    ohmic{ name = Body bias = 0.0 shift = 0.0 }
    fermi_hole{ name = remove_surface_charge bias = $V_remove_surface_charge }
    fermi_hole{ name = zero_fermi_QW bias = 0.0 }
}

structure{
    output_contact_index{ boxes = no }
    output_impurities{ boxes = no }
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }

    # background: SiGe_body_contact
    region{
        cuboid{
            x = [-1240, 1240]
            y = [0, 200]
            z = [-4115, -4015]
        }
        ternary_constant{ name = "Si(x)Ge(1-x)" alloy_x = 0.15 }
        contact{ name = Body }
    }

    # background: SiGe_buffer
    region{
        cuboid{
            x = [-1240, 1240]
            y = [0, 200]
            z = [-4015, -15]
        }
        ternary_constant{ name = "Si(x)Ge(1-x)" alloy_x = 0.15 }
    }

    # background: Ge_QW
    region{
        cuboid{
            x = [-1240, 1240]
            y = [0, 200]
            z = [-15, 0]
        }
        binary{ name = Ge }
        integrate{ hole_density{} }
    }

    # background: SiGe_cap
    region{
        cuboid{
            x = [-1240, 1240]
            y = [0, 200]
            z = [0, 101]
        }
        ternary_constant{ name = "Si(x)Ge(1-x)" alloy_x = 0.15 }
    }

    # background: Al2O3_dielectric
    region{
        cuboid{
            x = [-1240, 1240]
            y = [0, 200]
            z = [101, 173]
        }
        binary{ name = Sapphire_zb }
    }


    # auxiliary fermi_hole contact: remove_surface_charge
    region{
        cuboid{
            x = [-1240, 1240]
            y = [0, 200]
            z = [0, 101]
        }
        contact{ name = remove_surface_charge }
    }

    # auxiliary fermi_hole contact: zero_fermi_QW
    region{
        cuboid{
            x = [-1240, 1240]
            y = [0, 200]
            z = [-20, 5]
        }
        contact{ name = zero_fermi_QW }
    }


    # patterned region: OC_L
    region{
        polygonal_prism{
            z = [-149, 173]
            vertex{
                x = [-1240]
                y = [0]
            }
            vertex{
                x = [-1200]
                y = [0]
            }
            vertex{
                x = [-1200]
                y = [200]
            }
            vertex{
                x = [-1240]
                y = [200]
            }
        }
        contact{ name = "OC_L" }
    }

    # patterned region: B1
    region{
        polygonal_prism{
            z = [108, 138]
            vertex{
                x = [-200]
                y = [60]
            }
            vertex{
                x = [-160]
                y = [60]
            }
            vertex{
                x = [-160]
                y = [200]
            }
            vertex{
                x = [-200]
                y = [200]
            }
        }
        contact{ name = "B1" }
    }

    # patterned region: P1
    region{
        polygonal_prism{
            z = [143, 173]
            vertex{
                x = [-70]
                y = [200]
            }
            vertex{
                x = [-110]
                y = [200]
            }
            vertex{
                x = [-110]
                y = [150]
            }
            vertex{
                x = [-140]
                y = [125]
            }
            vertex{
                x = [-140]
                y = [75]
            }
            vertex{
                x = [-120]
                y = [50]
            }
            vertex{
                x = [-60]
                y = [50]
            }
            vertex{
                x = [-40]
                y = [75]
            }
            vertex{
                x = [-40]
                y = [125]
            }
            vertex{
                x = [-70]
                y = [150]
            }
        }
        contact{ name = "P1" }
    }

    # patterned region: B2
    region{
        polygonal_prism{
            z = [108, 138]
            vertex{
                x = [-20]
                y = [60]
            }
            vertex{
                x = [20]
                y = [60]
            }
            vertex{
                x = [20]
                y = [200]
            }
            vertex{
                x = [-20]
                y = [200]
            }
        }
        contact{ name = "B2" }
    }

    # patterned region: P2
    region{
        polygonal_prism{
            z = [143, 173]
            vertex{
                x = [110]
                y = [200]
            }
            vertex{
                x = [70]
                y = [200]
            }
            vertex{
                x = [70]
                y = [150]
            }
            vertex{
                x = [40]
                y = [125]
            }
            vertex{
                x = [40]
                y = [75]
            }
            vertex{
                x = [60]
                y = [50]
            }
            vertex{
                x = [120]
                y = [50]
            }
            vertex{
                x = [140]
                y = [75]
            }
            vertex{
                x = [140]
                y = [125]
            }
            vertex{
                x = [110]
                y = [150]
            }
        }
        contact{ name = "P2" }
    }

    # patterned region: B3
    region{
        polygonal_prism{
            z = [108, 138]
            vertex{
                x = [160]
                y = [60]
            }
            vertex{
                x = [200]
                y = [60]
            }
            vertex{
                x = [200]
                y = [200]
            }
            vertex{
                x = [160]
                y = [200]
            }
        }
        contact{ name = "B3" }
    }

    # patterned region: OC_R
    region{
        polygonal_prism{
            z = [-149, 173]
            vertex{
                x = [1200]
                y = [0]
            }
            vertex{
                x = [1240]
                y = [0]
            }
            vertex{
                x = [1240]
                y = [200]
            }
            vertex{
                x = [1200]
                y = [200]
            }
        }
        contact{ name = "OC_R" }
    }

}

grid{
    xgrid{
        line{ pos = -1240 spacing = $dx }
        line{ pos = -1220 spacing = $dx }
        line{ pos = -1200 spacing = $dx_coarse }
        line{ pos = -350 spacing = $dx_coarse }
        line{ pos = -220 spacing = $dx_QD }
        line{ pos = -200 spacing = $dx_QD }
        line{ pos = -180 spacing = $dx_QD }
        line{ pos = -160 spacing = $dx_QD }
        line{ pos = -140 spacing = $dx_QD }
        line{ pos = -90 spacing = $dx_QD }
        line{ pos = -40 spacing = $dx_QD }
        line{ pos = -20 spacing = $dx_QD }
        line{ pos = 0 spacing = $dx_QD }
        line{ pos = 20 spacing = $dx_QD }
        line{ pos = 40 spacing = $dx_QD }
        line{ pos = 90 spacing = $dx_QD }
        line{ pos = 140 spacing = $dx_QD }
        line{ pos = 160 spacing = $dx_QD }
        line{ pos = 180 spacing = $dx_QD }
        line{ pos = 200 spacing = $dx_QD }
        line{ pos = 220 spacing = $dx_QD }
        line{ pos = 350 spacing = $dx_coarse }
        line{ pos = 1200 spacing = $dx_coarse }
        line{ pos = 1220 spacing = $dx }
        line{ pos = 1240 spacing = $dx }
    }
    ygrid{
        line{ pos = 0 spacing = $dy_QD }
        line{ pos = 20 spacing = $dy_QD }
        line{ pos = 50 spacing = $dy_QD }
        line{ pos = 60 spacing = $dy_QD }
        line{ pos = 100 spacing = $dy_QD }
        line{ pos = 125 spacing = $dy_QD }
        line{ pos = 130 spacing = $dy_QD }
        line{ pos = 180 spacing = $dy_QD }
        line{ pos = 200 spacing = $dy_QD }
    }
    zgrid{
        line{ pos = -4115 spacing = $dz_buffer_coarse }
        line{ pos = -4015 spacing = $dz_buffer_coarse }
        line{ pos = -1015 spacing = $dz_buffer_medium }
        line{ pos = -165 spacing = $dz_buffer_fine }
        line{ pos = -149 spacing = $dz_oxide_gates_medium }
        line{ pos = -20 spacing = $dz_QW_coarse }
        line{ pos = -15 spacing = $dz_QW_fine }
        line{ pos = 0 spacing = $dz_QW_fine }
        line{ pos = 5 spacing = $dz_QW_coarse }
        line{ pos = 100 spacing = $dz_cap_fine }
        line{ pos = 101 spacing = $dz_cap_fine }
        line{ pos = 108 spacing = $dz_oxide_gates_medium }
        line{ pos = 138 spacing = $dz_oxide_gates_medium }
        line{ pos = 143 spacing = $dz_oxide_gates_medium }
        line{ pos = 173 spacing = $dz_oxide_gates_medium }
    }
}

strain {
    pseudomorphic_strain{}
    output_strain_tensor{}
    growth_direction = [0, 0, 1]
}

poisson{
#    between_fermi_levels{}
    charge_neutral{}
    output_electric_field{}
    output_potential{}
}

currents{
    recombination_model{}
#    insulator_bandgap = 5
}

classical{ 
    Gamma{}
    Delta{}
    L{}
    HH{}
    LH{}
    SO{}
    output_bandedges{}
    output_carrier_densities{}
    output_ionized_dopant_densities{}
}

quantum{
    region{
        name = "c-Ge_QW"
        x = [-220, 220]
        y = [20, 180]
        z = [-20, 5]

        boundary{
            x = neumann
            y = neumann
            z = neumann
        }

        HH{ num_ev = $n_c_Ge_QW_HH }
        LH{ num_ev = $n_c_Ge_QW_LH }

        !IF($decomposition)
            quantize_z{}
            output_wavefunctions{
                max_num = 100
                amplitudes = no
                probabilities = yes
            }
        !ELSE
            output_wavefunctions{
                max_num = 100
                amplitudes = no
                probabilities = yes
                all_k_points = no
                energy_shift = shifted
            }
        !ENDIF

        output_quantum_densities{}
    }
}

$shift = 0.0 

database{
# WARNING: The data below is just compied from our database (wz) and changed to zb here adapting the syntax where needed
# It was also required to add the L and delta bands only for syntax reasons. In this way the band gap
# of these bands were increased, in order they cannot taken into account in the computations
# Please check if the other parameters make sense!

    binary_zb {
        name    = Sapphire_zb
        valence = III_V                                         # III_V
        lattice_consts{     
     #   a     = 3.112                                          # AlN value
        a     = 4.63                                            # a in the hexagonal crystal
        a_expansion = 0                                         # ?
        }
        dielectric_consts{
            static_a  = 6.5                                     # www.crystran.co.uk/sappdata.htm  11.5 (para) 9.4 (perp) at 1MHz
            optical_a = 4.68                                    # AlN value
        }
        elastic_consts{
            c11 = 496       c12 = 164       #c13 = 115          # www.crystran.co.uk/sappdata.htm
            #c33 = 498       
            c44 = 148
        }
        piezoelectric_consts {
            #e31 = -0.50     e33 = 1.79                         # AlN value
            #e15 = -0.48                                        # AlN value
            e14 = 0.000                                         # Si value ( e14 was not in the database)
        }
        #    pyroelectric_consts {
        #        p1 = 0.0                                           
        #    }
        conduction_bands{
            Gamma{
            #   mass_l                = 0.32                    # AlN value
            #   mass_t                = 0.30                    # AlN value
            mass                 = 0.32                         # AlN value
            bandgap               = 6.5 + 0.5*$shift                         
            bandgap_alpha         = 0.0                         # ?
            bandgap_beta          = 0                           # ?
            #   defpot_absolute_l     = -3.4                    # AlN value  along c axis
            #   defpot_absolute_t     = -11.8                   # AlN value  perpendicular to c axis
            defpot_absolute        = -3.4                       # AlN value  along c axis
            }
            # from SiO2 - placed here, only for running (bandgap set to 10 to not be taken into account)
            L{
                mass_l                = 1.420                       # Si value
                mass_t                = 0.130                       # Si value
                bandgap               = 10                          # guess (0 K)
                bandgap_alpha         = 0
                bandgap_beta          = 0
                defpot_absolute       = 0
                defpot_uniaxial       = 0
            }
            #from SiO2 - placed here, only for running (bandgap set to 10 to not be taken into account)
            Delta{
                mass_l                = 0.5                          # M. Fischetti, JAP 83, 270 (1998)
                mass_t                = 0.5                          # M. Fischetti, JAP 83, 270 (1998)
                bandgap               = 10                           # (0 K)
                bandgap_alpha         = 0
                bandgap_beta          = 0
                defpot_absolute       = 0
                defpot_uniaxial       = 0
                position              = 0.85                         # Si value
            }
        }
        valence_bands{
            bandoffset        = -1.41 - 0.5 * $shift         # AlN value
    
            # commented out below: previous values, for Sapphire wurtzite        
            # HH{ mass_l = 3.53      mass_t = 10.42 }               # AlN value
            #  LH{ mass_l = 3.53      mass_t = 0.24  }              # AlN value
            # SO{ mass_l = 0.25      mass_t = 3.81  }               # AlN value

            HH{ mass          = 3.53      }                         # AlN value
            LH{ mass          = 3.53      }                         # AlN value
            SO{ mass          = 0.25 }                              # AlN value
            #  defpotentials = [ 0, 0, 0, 0, 0, 0 ]                 # ?
            defpot_absolute   = 0
            defpot_uniaxial_b = 0   defpot_uniaxial_d = 0
            # delta = [-0.169 , 0.00633, 0.00633 ]                  # AlN value
            delta_SO          = 0.0                                 # No information available for this parameter
        }
        kp_6_bands{ L = -6.69   M = -4.62   N = -8.56  kappa = -0.42 }  # Si values
    
            # commented out below: previous values, for Sapphire wurtzite
            #    kp_6_bands{
            #        A1 = -3.86     A2 = -0.25      A3 =  3.58              # AlN value
            #        A4 = -1.32     A5 = -1.47      A6 = -1.64              # AlN value
            #    }
            #    kp_8_bands{                                                #
            #        S1   =  0.805    S2   =  1.013                         # AlN value
            #        E_P1 = 14.5      E_P2 = 14.5                           # AlN value
            #        B1   =  0        B2   =  0         B3 =  0             # AlN value
            #        A1   = -1.540    A2   = -0.25      A3 =  1.260         # AlN value
            #        A4   = -0.160    A5   = -0.310     A6 =  4.877         # AlN value
            #    }
    
            # kp_8 parameters below were taken from SiO2 ( and comments)
        kp_8_bands{                                                # No useful model for indirect bandgap materials!
            S = 6.41                                               # inverse effective mass
            E_P = 0                                                # decoupled bands
            B = 0                                                  # This value is zero in group IV semiconductors (inversion symmetry).
            L = -6.69   M = -4.62   N = -8.56  kappa = -0.42       # 6-band parameters
        }
        mobility_constant{
            electrons{  mumax = 100      exponent = 1.0  }         # AlN value
            holes{      mumax = 100      exponent = 1.0  }         # AlN value
        }
        recombination{
            SRH{       tau_n = 1.0e-9      nref_n = 1.0e19         # InP value !!!
                   tau_p = 1.0e-9      nref_p = 1.0e18         # InP value !!!
            }
            Auger{     c_n = 0             c_p = 0 }               # InP value !!! 
            radiative{ c = 1.1e-8 }                                # GaN value !!!
        }
    }
}
